DATABASE_URL=sqlite:///./content_factory.db
# Dedicated DBOS workflow metadata store; must never resolve to DATABASE_URL.
DBOS_SYSTEM_DATABASE_URL=sqlite:///./dbos_system.db
OUTPUT_DIR=./out
CHANNEL_DEFAULT_NAME=Local AI Operator
REQUIRE_HUMAN_REVIEW=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.5

# --- Live demand ranking (bullet 3) ---
# YouTube Data API v3 key. When set, idea ranking and batch production use real
# view-velocity / recency / saturation signals instead of the keyword heuristic.
YOUTUBE_DATA_API_KEY=

# --- Affiliate / lead-gen revenue ---
# JSON array of offers injected into every generated description (with FTC
# disclosure). Example:
# AFFILIATE_OFFERS_JSON=[{"name":"AI Receptionist Tool","url":"https://yourreflink","cta":"Try free","coupon":"OPTIONAL"}]
AFFILIATE_OFFERS_JSON=

# --- YouTube private upload (bullet 2) ---
# Uploads finished, review-passed videos as PRIVATE for final human publish.
# Requires: pip install google-api-python-client google-auth google-auth-oauthlib
# One-time setup (mints the refresh token below):
#   python3.11 scripts/youtube_oauth_setup.py --client-id ... --client-secret ...
ENABLE_YOUTUBE_UPLOADS=false
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
YOUTUBE_OAUTH_REFRESH_TOKEN=
